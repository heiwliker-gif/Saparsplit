# Скопируйте файл в .env и заполните значениями своей среды.

# Client ID из Google Cloud Console → OAuth 2.0 Client IDs (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Длинная случайная строка для подписи сессионных JWT-токенов
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL connection string
POSTGRES_PASSWORD=local_saparsplit_password
DATABASE_URL=postgresql://saparsplit:local_saparsplit_password@localhost:5432/saparsplit

# Порт Express-сервера
PORT=3000

# Необязательно: включите для PostgreSQL-провайдеров, требующих SSL.
PGSSL=false

# Необязательно: путь к старой SQLite-базе при импорте.
# SQLITE_PATH=./db/saparsplit.db

# Необязательно: ключ 2GIS MapGL для Vite; публичный клиентский ключ.
# VITE_MAPGL_KEY=your-2gis-mapgl-key
