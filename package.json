{
  "name": "saparsplit-backend",
  "version": "1.0.0",
  "description": "SaparSplit trip expense app with a React client and PostgreSQL API",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "vite --config client/vite.config.js",
    "dev:server": "node --watch server.js",
    "build": "vite build --config client/vite.config.js",
    "migrate:sqlite": "node scripts/migrate-sqlite-to-postgres.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.7"
  }
}
